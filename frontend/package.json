{
  "name": "rare-basket-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --no-progress",
    "test": "ng test --no-progress --no-watch",
    "lint": "pnpx mkdirp build && ng lint > build/eslint-result.txt",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "e2e": "pnpm playwright test",
    "postinstall": "pnpm exec playwright install",
    "knip": "pnpx knip --fix-type exports,types --exclude dependencies,unlisted,files,binaries --tags=knipignore"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "26.13.1"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/localize": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@fortawesome/angular-fontawesome": "5.1.0",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@ngx-translate/core": "18.1.0",
    "@popperjs/core": "2.11.8",
    "angular-auth-oidc-client": "22.0.2",
    "bootstrap": "5.3.8",
    "chart.js": "4.6.1",
    "ngx-valdemort": "16.0.1",
    "papaparse": "5.7.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/papaparse": "5.5.2",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "@vitest/spy": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "oxfmt": "0.77.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
